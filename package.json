{
  "name": "image-viewer",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "src/gallery.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gallery.css": "./src/gallery.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "prepack": "npm run build"
  },
  "dependencies": {
    "kr-observable": "3.2.5"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "^10.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.1"
  }
}
